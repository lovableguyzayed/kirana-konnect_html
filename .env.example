# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored, so your credentials are never committed.

# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" URI (port 5432) for a long-running server like this.
# Example shape (replace the bracketed parts):
#   postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Flask session secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Secret code needed for "Forgot password" (min 6 characters). Keep it private.
# With many shops on one server this is an ADMIN code: whoever has it can reset
# any shop's password. Give shop owners SMS OTP instead; keep this for yourself.
# Without it, password reset is switched off.
OWNER_RESET_CODE=

# Support contacts shown on /contact, /privacy and /account-deletion
# (Google Play and India's DPDP rules need a reachable grievance contact).
SUPPORT_NAME=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

# SMS OTP for login and forgot password (off when empty).
#   msg91   -> real SMS via MSG91; needs both values below. The OTP template
#              must be approved on TRAI DLT and contain the ##OTP## variable.
#   console -> TESTING ONLY: the code is written to the server log.
SMS_PROVIDER=
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=
